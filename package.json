{
  "name": "hs-plugin-fpp",
  "version": "0.1.0",
  "description": "Light Show: a Home Screens home base for a Falcon Player (FPP) light show",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite build && (vite build --watch & npx -y serve@latest . -l 5173 --cors --no-clipboard)",
